NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Runtime connection. Use the Supabase session-mode pooler (port 5432) so that
# Prisma interactive transactions keep a single pinned connection.
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
JWT_ACCESS_SECRET=your_32_character_minimum_access_secret_here
JWT_REFRESH_SECRET=your_32_character_minimum_refresh_secret_here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PAYMENT_PROVIDER=mock
PLATFORM_FEE_PERCENT=10
STORAGE_DIR=./storage
